#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if ! command -v bun >/dev/null 2>&1; then
  echo "WebP conversion requires Bun. Install Bun, then run:" >&2
  echo "  https://bun.com/docs/installation" >&2
  exit 1
fi

bun .github/workflows/scripts/convert-to-webp.js --staged
